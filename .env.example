NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_VISIBILITY_SECONDS=30
SQS_HEARTBEAT_MS=10000
SQS_RETRY_BASE_SECONDS=1
SQS_RETRY_MAX_SECONDS=300

REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_INTERVAL_MS=1000
REFERENCE_WORKER_BATCH_SIZE=25
REFERENCE_MAX_ATTEMPTS=20
REFERENCE_TTL_MS=86400000
REFERENCE_BASE_DELAY_MS=1000
REFERENCE_MAX_DELAY_MS=300000

